# Git worktrees managed by superpowers:using-git-worktrees
/.worktrees/

# Machine-specific local build helper (exFAT/Windows workaround, personal paths)
build-ui-local.ps1

# Screenshots dropped in the repo root for sharing during field testing.
# Root-anchored so the tracked PNGs under crates/ (app icons, test fixtures)
# are unaffected.
/*.png
